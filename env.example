# PostgreSQL (обязательно)
DATABASE_URL=postgresql://postgres:password@localhost:5432/enter_marketing

# Админ-панель: /admin/login
# Логин сидируется при npm run db:migrate (entermarketing@gmail.com)
ADMIN_PASSWORD=

# Секрет для сессий и OAuth state (случайная строка 32+ символов)
AUTH_SECRET=change-me-to-a-long-random-string

# Публичный URL сайта (для Google redirect и писем)
APP_URL=http://localhost:3000

# Google OAuth — в консоли добавьте redirect:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP (пароль приложения, не обычный пароль аккаунта)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
